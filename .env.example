# Inventarios / AlmacénSMEX — copiar a .env (NO subir .env a Git)

VITE_APP_SUPABASE_URL=https://your-inventarios-project.supabase.co
VITE_APP_SUPABASE_ANON_KEY=your-inventarios-anon-key
VITE_DEFAULT_EMPRESA_ID=1
VITE_DEFAULT_USUARIO_ID=1
VITE_EMPRESA_TABLE=empresa

# Shonan OS (botón "Volver a Compras" en Home)
# En servidor LAN usar la IP de la máquina, ej. http://192.168.1.50:5000
VITE_SHONAN_APP_URL=http://192.168.1.50:5000
